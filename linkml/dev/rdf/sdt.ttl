        <https://w3id.org/dartfx/semanticdt/ValidationRule> ;
    linkml:default_prefix "sdt" ;
    linkml:default_range <https://w3id.org/dartfx/semanticdt/string> ;
    linkml:description "A schema defining Semantic Data Types (SDT) situated above physical database or programming types. Encompasses metadata, mappings, validation, generation, and agentic instructions." ;
    linkml:enums <https://w3id.org/dartfx/semanticdt/TargetEnvironmentEnum> ;
    linkml:generation_date "2026-06-09T14:42:23"^^xsd:dateTime ;
    linkml:id "https://w3id.org/dartfx/semanticdt"^^xsd:anyURI ;
    linkml:imports "linkml:types"^^xsd:anyURI ;
    linkml:metamodel_version "1.11.0" ;
