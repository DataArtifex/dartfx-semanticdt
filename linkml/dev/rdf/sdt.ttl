<https://w3id.org/dartfx/semanticdt/semantic-data-type> a linkml:SchemaDefinition ;
    dcterms:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    dcterms:title "Semantic Data Type Schema" ;
    pav:version "0.1.0-dev" ;
