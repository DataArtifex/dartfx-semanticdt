<https://w3id.org/dartfx/semanticdt/TargetEnvironmentEnum> skos:inScheme "https://w3id.org/dartfx/semanticdt"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/dartfx/semanticdt/TargetEnvironmentEnum"^^xsd:anyURI ;
    linkml:description "Recommended vocabulary of target systems and development environments." ;
    linkml:permissible_values <https://w3id.org/dartfx/semanticdt/csharp>,
        <https://w3id.org/dartfx/semanticdt/generic>,
        <https://w3id.org/dartfx/semanticdt/go>,
        <https://w3id.org/dartfx/semanticdt/java>,
        <https://w3id.org/dartfx/semanticdt/javascript>,
