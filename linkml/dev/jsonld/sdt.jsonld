        "semanticDataType__validation_rules",
        "semanticDataType__generation_rules",
        "semanticDataType__agent_instructions",
        "semanticDataType__agent_skills",
        "semanticDataType__scope",
        "semanticDataType__display_format",
        "semanticDataType__examples",
        "semanticDataType__resources"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "id",
          "description": "Unique identifier/URI for the Semantic Data Type.",
          "identifier": true,
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "name",
          "description": "Human-readable name of the Semantic Data Type.",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "description",
