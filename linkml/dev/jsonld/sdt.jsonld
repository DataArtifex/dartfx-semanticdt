  "classes": [
    {
      "name": "SemanticDataType",
      "definition_uri": "https://w3id.org/dartfx/semanticdt/SemanticDataType",
      "description": "A high-level data type associated with a distinct concept, validation/generation rules, and metadata.",
      "from_schema": "https://w3id.org/dartfx/semanticdt",
      "slots": [
        "semanticDataType__id",
        "semanticDataType__name",
        "semanticDataType__description",
        "semanticDataType__version",
        "semanticDataType__concepts",
        "semanticDataType__storage_types",
