@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdt: <https://w3id.org/dartfx/semanticdt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sdt:SemanticDataType a sh:NodeShape ;
    rdfs:comment "A high-level data type associated with a distinct concept, validation/generation rules, and metadata." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sdt:ScopeContext ;
            sh:description "Contextual scope of the data type (temporal, geographic, etc.)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path sdt:scope ],
        [ sh:class sdt:Example ;
            sh:description "Curated valid and invalid examples for documentation and testing." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path sdt:examples ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier/URI for the Semantic Data Type." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sdt:id ],
        [ sh:class sdt:ConceptReference ;
            sh:description "A list of conceptual ontology alignments or mapping references representing this data type in external systems (e.g., SKOS concepts, Wikidata items, or vocabularies like DDI-CDI and schema.org). This should list multiple representations of the same underlying semantic concept, not distinct concepts." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path sdt:concepts ],
        [ sh:class sdt:ClassificationSystem ;
            sh:description "Code lists or classification schemes that categorize this variable." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path sdt:classification ],
        [ sh:class sdt:GenerationRule ;
            sh:description "Templates or directives for generating synthetic valid data." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path sdt:generation_rules ],
        [ sh:class sdt:ValidationRule ;
            sh:description "Rules to validate physical representations of the data type." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path sdt:validation_rules ],
        [ sh:class sdt:StorageType ;
            sh:description "Mappings to physical storage types across different environments. A mapping for the 'generic' environment is required to define the platform-independent base type." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path sdt:storage_types ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name of the Semantic Data Type." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sdt:name ],
        [ sh:class sdt:AgentInstruction ;
            sh:description "Specific guidelines and instructions for AI agents handling this data type." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path sdt:agent_instructions ],
        [ sh:class sdt:AgentSkill ;
            sh:description "Tools, functions, or prompts associated with this data type." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path sdt:agent_skills ],
        [ sh:datatype xsd:string ;
            sh:description "The version of the Semantic Data Type instance definition (e.g., 1.0.0)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path sdt:version ],
        [ sh:class sdt:Resource ;
            sh:description "External resources and references related to the Semantic Data Type." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path sdt:resources ],
        [ sh:class sdt:DisplayFormat ;
            sh:description "Formatting rules for displaying values of this type." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path sdt:display_format ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description of the Semantic Data Type." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sdt:description ] ;
    sh:targetClass sdt:SemanticDataType .

sdt:AgentInstruction a sh:NodeShape ;
    rdfs:comment "Machine and agentic parsing, transformation, or reasoning guidelines." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Text instructions for agents." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sdt:guidelines ],
        [ sh:datatype xsd:string ;
            sh:description "System prompt instructions for configuring agents with this data type." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sdt:system_prompt_snippet ] ;
    sh:targetClass sdt:AgentInstruction .

sdt:AgentSkill a sh:NodeShape ;
    rdfs:comment "Executable tools, functions, or workflows related to the semantic type." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "What this skill does." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sdt:description ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the tool or function." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sdt:tool_name ],
        [ sh:datatype xsd:string ;
            sh:description "API endpoint or function signature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sdt:api_definition ] ;
    sh:targetClass sdt:AgentSkill .

sdt:ClassificationSystem a sh:NodeShape ;
    rdfs:comment "Controlled vocabulary or coding scheme (making this a categorical variable)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Version of the classification scheme." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sdt:version ],
        [ sh:datatype xsd:string ;
            sh:description "URI to the standard classification." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sdt:uri ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the classification (e.g., ISO-3166-1, ICD-10)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sdt:name ] ;
    sh:targetClass sdt:ClassificationSystem .

sdt:ConceptReference a sh:NodeShape ;
    rdfs:comment "Reference to a concept in an external ontology or vocabulary." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:defaultValue "exactMatch"^^xsd:string ;
            sh:description "Relationship to the concept (e.g., exactMatch, closeMatch, broadMatch, narrowMatch)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path sdt:match_type ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the vocabulary or ontology (e.g., SKOS, DDI-CDI, Wikidata, LCSH)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sdt:vocabulary ],
        [ sh:datatype xsd:string ;
            sh:description "URI of the concept (e.g., SKOS URI)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sdt:uri ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred label of the concept in the ontology." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sdt:pref_label ] ;
    sh:targetClass sdt:ConceptReference .

sdt:DisplayFormat a sh:NodeShape ;
    rdfs:comment "Guidelines for displaying and masking data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Regex used to transform raw data to formatted data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sdt:formatting_regex ],
        [ sh:datatype xsd:string ;
            sh:description "Output representation template." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sdt:display_template ],
        [ sh:datatype xsd:string ;
            sh:description "Mask for input forms (e.g., 999-99-9999)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sdt:input_mask ] ;
    sh:targetClass sdt:DisplayFormat .

sdt:Example a sh:NodeShape ;
    rdfs:comment "Concrete instance of values." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Indication of whether the example value is valid under the SDT." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sdt:is_valid ],
        [ sh:datatype xsd:string ;
            sh:description "Example value representation." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sdt:value ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the specific test case this example represents." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sdt:description ] ;
    sh:targetClass sdt:Example .

sdt:GenerationRule a sh:NodeShape ;
    rdfs:comment "Directive for synthetic data generation." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Type of generator (e.g., regex_fuzzer, template, faker_provider, custom)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sdt:generator_type ],
        [ sh:class sdt:CodeSnippet ;
            sh:description "Environment-specific code snippets or expressions implementing the generator logic." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path sdt:code_snippets ],
        [ sh:datatype xsd:string ;
            sh:description "Seed template or expression." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sdt:template ] ;
    sh:targetClass sdt:GenerationRule .

sdt:GeospatialCoverage a sh:NodeShape ;
    rdfs:comment "Geospatial coverage boundaries represented by description and/or formal codes or URIs." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A list of formal codes or URIs (e.g., ISO country/subdivision codes, GeoNames URIs, Wikidata URIs)." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sdt:codes ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable description of the geospatial coverage (e.g., United States, Canada, Global)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sdt:description ] ;
    sh:targetClass sdt:GeospatialCoverage .

sdt:Resource a sh:NodeShape ;
    rdfs:comment "An external resource, citation, or reference related to the Semantic Data Type (using simple Dublin Core elements)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The URL/URI of the resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sdt:url ],
        [ sh:datatype xsd:string ;
            sh:description "The entity or publisher responsible for making the resource available." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path sdt:publisher ],
        [ sh:datatype xsd:string ;
            sh:description "A formal bibliographic citation for the resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path sdt:citation ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name of the resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sdt:title ],
        [ sh:datatype xsd:string ;
            sh:description "A brief summary or account of the resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sdt:description ] ;
    sh:targetClass sdt:Resource .

sdt:ScopeContext a sh:NodeShape ;
    rdfs:comment "Contextual boundaries of the data type." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Governing body (e.g., ISO, W3C, IRS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path sdt:governing_institution ],
        [ sh:class sdt:GeospatialCoverage ;
            sh:description "Geospatial region or country coverage details." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path sdt:geospatial_coverage ],
        [ sh:class sdt:TemporalCoverage ;
            sh:description "Temporal coverage details." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path sdt:temporal_coverage ],
        [ sh:datatype xsd:string ;
            sh:description "Specific field or subject domain (e.g., Healthcare, Finance)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sdt:domain ] ;
    sh:targetClass sdt:ScopeContext .

sdt:StorageType a sh:NodeShape ;
    rdfs:comment "Physical or logical storage data type binding." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Target platform, framework, database, or language. Prefer using values from the TargetEnvironmentEnum controlled vocabulary where applicable. Custom values not in the enum are permitted since this slot is of type string." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sdt:target_environment ],
        [ sh:datatype xsd:string ;
            sh:description "Data type identifier in the target environment (e.g., string, varchar, integer, str)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sdt:data_type ],
        [ sh:datatype xsd:string ;
            sh:description "Optional modifiers (e.g., length, precision)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sdt:format_modifier ] ;
    sh:targetClass sdt:StorageType .

sdt:TemporalCoverage a sh:NodeShape ;
    rdfs:comment "Temporal coverage boundaries represented by description, start/end dates, or ISO 8601 periods/durations." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Start date of the coverage formatted strictly according to ISO 8601 (YYYY-MM-DD)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sdt:start_date ;
            sh:pattern "^\\d{4}-\\d{2}-\\d{2}$" ],
        [ sh:datatype xsd:string ;
            sh:description "ISO 8601 time interval or period representation (e.g., '2020-01-01/2020-12-31', 'P1Y')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path sdt:iso_period ],
        [ sh:datatype xsd:string ;
            sh:description "End date of the coverage formatted strictly according to ISO 8601 (YYYY-MM-DD)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sdt:end_date ;
            sh:pattern "^\\d{4}-\\d{2}-\\d{2}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable description of the temporal coverage (e.g., '21st Century', '2020 Census')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sdt:description ] ;
    sh:targetClass sdt:TemporalCoverage .

sdt:ValidationRule a sh:NodeShape ;
    rdfs:comment "A rule defining syntactical or logical validation of values." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Error message when validation fails." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path sdt:message ],
        [ sh:datatype xsd:string ;
            sh:description "Regular expression pattern for validation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sdt:pattern ],
        [ sh:datatype xsd:string ;
            sh:description "Type of validation (e.g., regex, checksum, range)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sdt:rule_type ],
        [ sh:datatype xsd:string ;
            sh:description "Algorithmic checker name (e.g., luhn, modulo-11, isbn13)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sdt:algorithm ],
        [ sh:class sdt:CodeSnippet ;
            sh:description "Environment-specific code snippets or expressions implementing the validation logic." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path sdt:code_snippets ] ;
    sh:targetClass sdt:ValidationRule .

sdt:CodeSnippet a sh:NodeShape ;
    rdfs:comment "A concrete piece of code or expression implementing logic (e.g., validation, generation) in a specific environment." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Target platform, framework, database, or language. Prefer using values from the TargetEnvironmentEnum controlled vocabulary where applicable. Custom values not in the enum are permitted since this slot is of type string." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sdt:target_environment ],
        [ sh:datatype xsd:string ;
            sh:description "The actual code snippet or expression (e.g., Python function/lambda, SQL expression)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sdt:code ] ;
    sh:targetClass sdt:CodeSnippet .
