@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdt: <https://w3id.org/dartfx/semanticdt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/dartfx/semanticdt.owl.ttl> a owl:Ontology ;
    rdfs:label "semantic-data-type" ;
    dcterms:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    dcterms:title "Semantic Data Type Schema" ;
    pav:version "0.1.0-dev" ;
    skos:definition "A schema defining Semantic Data Types (SDT) situated above physical database or programming types. Encompasses metadata, mappings, validation, generation, and agentic instructions." .

sdt:SemanticDataType a owl:Class ;
    rdfs:label "SemanticDataType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:display_format ],
        [ a owl:Restriction ;
            owl:allValuesFrom sdt:Resource ;
            owl:onProperty sdt:resources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:validation_rules ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:agent_instructions ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom sdt:ScopeContext ;
            owl:onProperty sdt:scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom sdt:StorageType ;
            owl:onProperty sdt:storage_types ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:storage_types ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:agent_skills ],
        [ a owl:Restriction ;
            owl:allValuesFrom sdt:AgentSkill ;
            owl:onProperty sdt:agent_skills ],
        [ a owl:Restriction ;
            owl:allValuesFrom sdt:Example ;
            owl:onProperty sdt:examples ],
        [ a owl:Restriction ;
            owl:allValuesFrom sdt:ConceptReference ;
            owl:onProperty sdt:concepts ],
        [ a owl:Restriction ;
            owl:allValuesFrom sdt:AgentInstruction ;
            owl:onProperty sdt:agent_instructions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:resources ],
        [ a owl:Restriction ;
            owl:allValuesFrom sdt:ClassificationSystem ;
            owl:onProperty sdt:classification ],
        [ a owl:Restriction ;
            owl:allValuesFrom sdt:ValidationRule ;
            owl:onProperty sdt:validation_rules ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:display_format ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:agent_instructions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:examples ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:classification ],
        [ a owl:Restriction ;
            owl:allValuesFrom sdt:DisplayFormat ;
            owl:onProperty sdt:display_format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:classification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:generation_rules ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:concepts ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom sdt:GenerationRule ;
            owl:onProperty sdt:generation_rules ] ;
    skos:definition "A high-level data type associated with a distinct concept, validation/generation rules, and metadata." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:iso_date a owl:DatatypeProperty ;
    rdfs:label "iso_date" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^\\d{4}-\\d{2}-\\d{2}$" ] ) ] ) ] ;
    skos:definition "A date string formatted strictly according to ISO 8601 (YYYY-MM-DD)." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:AgentInstruction a owl:Class ;
    rdfs:label "AgentInstruction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:system_prompt_snippet ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:guidelines ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:guidelines ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:system_prompt_snippet ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:system_prompt_snippet ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:guidelines ] ;
    skos:definition "Machine and agentic parsing, transformation, or reasoning guidelines." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:AgentSkill a owl:Class ;
    rdfs:label "AgentSkill" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:tool_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:tool_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:api_definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:tool_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:api_definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:api_definition ] ;
    skos:definition "Executable tools, functions, or workflows related to the semantic type." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:ClassificationSystem a owl:Class ;
    rdfs:label "ClassificationSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:uri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:uri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:version ] ;
    skos:definition "Controlled vocabulary or coding scheme (making this a categorical variable)." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:ConceptReference a owl:Class ;
    rdfs:label "ConceptReference" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:vocabulary ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:vocabulary ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:vocabulary ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:pref_label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:uri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:pref_label ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:uri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:pref_label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:match_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:match_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:match_type ] ;
    skos:definition "Reference to a concept in an external ontology or vocabulary." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:DisplayFormat a owl:Class ;
    rdfs:label "DisplayFormat" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:formatting_regex ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:formatting_regex ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:display_template ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:display_template ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:display_template ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:formatting_regex ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:input_mask ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:input_mask ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:input_mask ] ;
    skos:definition "Guidelines for displaying and masking data." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:Example a owl:Class ;
    rdfs:label "Example" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:is_valid ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty sdt:is_valid ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:is_valid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:value ] ;
    skos:definition "Concrete instance of values." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:GenerationRule a owl:Class ;
    rdfs:label "GenerationRule" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:template ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:template ],
        [ a owl:Restriction ;
            owl:allValuesFrom sdt:CodeSnippet ;
            owl:onProperty sdt:code_snippets ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:code_snippets ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:generator_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:template ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:generator_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:generator_type ] ;
    skos:definition "Directive for synthetic data generation." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:GeospatialCoverage a owl:Class ;
    rdfs:label "GeospatialCoverage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:codes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:codes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:description ] ;
    skos:definition "Geospatial coverage boundaries represented by description and/or formal codes or URIs." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:Resource a owl:Class ;
    rdfs:label "Resource" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:citation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:publisher ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:publisher ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:citation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:citation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:publisher ] ;
    skos:definition "An external resource, citation, or reference related to the Semantic Data Type (using simple Dublin Core elements)." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:ScopeContext a owl:Class ;
    rdfs:label "ScopeContext" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:governing_institution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:temporal_coverage ],
        [ a owl:Restriction ;
            owl:allValuesFrom sdt:TemporalCoverage ;
            owl:onProperty sdt:temporal_coverage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:temporal_coverage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:domain ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:governing_institution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:domain ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:domain ],
        [ a owl:Restriction ;
            owl:allValuesFrom sdt:GeospatialCoverage ;
            owl:onProperty sdt:geospatial_coverage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:governing_institution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:geospatial_coverage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:geospatial_coverage ] ;
    skos:definition "Contextual boundaries of the data type." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:StorageType a owl:Class ;
    rdfs:label "StorageType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:data_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:target_environment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:format_modifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:target_environment ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:target_environment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:data_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:data_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:format_modifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:format_modifier ] ;
    skos:definition "Physical or logical storage data type binding." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:TemporalCoverage a owl:Class ;
    rdfs:label "TemporalCoverage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:end_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:start_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:start_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:iso_period ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^\\d{4}-\\d{2}-\\d{2}$" ] ) ] ;
            owl:onProperty sdt:end_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:iso_period ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:iso_period ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:end_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^\\d{4}-\\d{2}-\\d{2}$" ] ) ] ;
            owl:onProperty sdt:start_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:description ] ;
    skos:definition "Temporal coverage boundaries represented by description, start/end dates, or ISO 8601 periods/durations." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:ValidationRule a owl:Class ;
    rdfs:label "ValidationRule" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:pattern ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:message ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:pattern ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:message ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:rule_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom sdt:CodeSnippet ;
            owl:onProperty sdt:code_snippets ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:algorithm ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:message ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:rule_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:algorithm ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:code_snippets ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:pattern ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sdt:algorithm ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:rule_type ] ;
    skos:definition "A rule defining syntactical or logical validation of values." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:CodeSnippet a owl:Class ;
    rdfs:label "CodeSnippet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:code ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:target_environment ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sdt:code ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:code ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sdt:target_environment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sdt:target_environment ] ;
    skos:definition "A concrete piece of code or expression implementing logic (e.g., validation, generation) in a specific environment." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

<https://w3id.org/dartfx/semanticdt/TargetEnvironmentEnum#csharp> a owl:Class ;
