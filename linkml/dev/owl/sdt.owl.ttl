sdt:codes a owl:DatatypeProperty ;
    rdfs:label "codes" ;
    skos:definition "A list of formal codes or URIs (e.g., ISO country/subdivision codes, GeoNames URIs, Wikidata URIs)." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:concepts a owl:ObjectProperty ;
    rdfs:label "concepts" ;
    skos:definition "A list of conceptual ontology alignments or mapping references representing this data type in external systems (e.g., SKOS concepts, Wikidata items, or vocabularies like DDI-CDI and schema.org). This should list multiple representations of the same underlying semantic concept, not distinct concepts." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:examples a owl:ObjectProperty ;
    rdfs:label "examples" ;
    skos:definition "Curated valid and invalid examples for documentation and testing." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:generation_rules a owl:ObjectProperty ;
    rdfs:label "generation_rules" ;
    skos:definition "Templates or directives for generating synthetic valid data." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:resources a owl:ObjectProperty ;
    rdfs:label "resources" ;
    skos:definition "External resources and references related to the Semantic Data Type." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:storage_types a owl:ObjectProperty ;
    rdfs:label "storage_types" ;
    skos:definition "Mappings to physical storage types across different environments. A mapping for the 'generic' environment is required to define the platform-independent base type." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:validation_rules a owl:ObjectProperty ;
    rdfs:label "validation_rules" ;
    skos:definition "Rules to validate physical representations of the data type." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:agent_instructions a owl:ObjectProperty ;
    rdfs:label "agent_instructions" ;
    skos:definition "Specific guidelines and instructions for AI agents handling this data type." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:algorithm a owl:DatatypeProperty ;
    rdfs:label "algorithm" ;
    skos:definition "Algorithmic checker name (e.g., luhn, modulo-11, isbn13)." ;
    skos:inScheme <https://w3id.org/dartfx/semanticdt> .

sdt:api_definition a owl:DatatypeProperty ;
    rdfs:label "api_definition" ;
