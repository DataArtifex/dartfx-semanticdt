<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "Semantic Data Types" }} | DataArtifex</title>
  <meta name="description" content="{{ description or 'A registry and specification portal for Semantic Data Types (SDT).' }}">

  <!-- SEO & OpenGraph Meta Tags -->
  <meta property="og:title" content="{{ title or 'Semantic Data Types' }}">
  <meta property="og:description" content="{{ description or 'A registry and specification portal for Semantic Data Types (SDT).' }}">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">

  <!-- Main Stylesheet -->
  <link rel="stylesheet" href="/css/index.css">
</head>
<body>

  <!-- Navigation Header -->
  <header>
    <div class="container header-container">
      <a href="/" class="logo">
        dartfx:semanticdt <span>dev</span>
      </a>
      <nav id="nav-menu">
        <a href="/" id="nav-home">Overview</a>
        <a href="/library/" id="nav-library">Library</a>
        <a href="/spec/" id="nav-spec">Specification</a>
        <a href="/playground/" id="nav-playground">Playground</a>
        <a href="https://github.com/DataArtifex/dartfx-semanticdt" target="_blank" rel="noopener" class="github-link">
          <svg height="16" viewBox="0 0 16 16" width="16" fill="currentColor" style="display:inline-block;vertical-align:text-bottom;">
            <path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
          </svg>
          GitHub
        </a>
      </nav>
    </div>
  </header>

  <!-- Main Content Wrapper -->
  <main class="container">
    {{ content | safe }}
  </main>

  <!-- Footer -->
  <footer>
    <div class="container">
      <div class="footer-links">
        <a href="/about/">About</a>
        <a href="/terms/">Terms of Service</a>
        <a href="/privacy/">Privacy Policy</a>
        <a href="/contact/">Contact</a>
        <a href="https://github.com/DataArtifex/dartfx-semanticdt/issues" target="_blank" rel="noopener">Report Issue</a>
      </div>
      <p>&copy; 2026 DataArtifex. Software licensed under MIT. Metadata schemas & library definitions dedicated to the public domain under CC0 1.0.</p>
    </div>
  </footer>

  <!-- Client-side script utilities -->
  <script>
    // Highlight active link in navigation
    document.addEventListener("DOMContentLoaded", () => {
      const path = window.location.pathname;
      const navHome = document.getElementById("nav-home");
      const navLibrary = document.getElementById("nav-library");
      const navSpec = document.getElementById("nav-spec");
      const navPlayground = document.getElementById("nav-playground");

      if (path === "/" || path === "/index.html") {
        navHome.classList.add("active");
      } else if (path.startsWith("/library/")) {
        navLibrary.classList.add("active");
      } else if (path.startsWith("/spec/")) {
        navSpec.classList.add("active");
      } else if (path.startsWith("/playground/")) {
        navPlayground.classList.add("active");
      }
    });

    // Copy to clipboard utility function
    function copyToClipboard(button, targetId) {
      const target = document.getElementById(targetId);
      if (!target) return;

      const text = target.innerText || target.textContent;
      navigator.clipboard.writeText(text).then(() => {
        const originalText = button.innerHTML;
        button.innerHTML = "Copied!";
        button.style.borderColor = "var(--status-success)";
        button.style.color = "var(--status-success)";
        setTimeout(() => {
          button.innerHTML = originalText;
          button.style.borderColor = "";
          button.style.color = "";
        }, 2000);
      }).catch(err => {
        console.error("Failed to copy text: ", err);
      });
    }
  </script>
</body>
</html>
